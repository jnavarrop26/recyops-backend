# Plantilla de variables de entorno del backend RecyOps.
# Copia este archivo como .env.properties y reemplaza los valores reales.
# Donde encontrarlos en Supabase:
#   - DB URL/USER/PASSWORD: boton "Connect" > Connection String (Session pooler, puerto 5432)
#   - URL y llaves: Project Settings > Data API / API Keys
SUPABASE_DB_URL=jdbc:postgresql://aws-1-us-east-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.tu-ref-de-proyecto
SUPABASE_DB_PASSWORD=cambiame
SUPABASE_URL=https://tu-ref-de-proyecto.supabase.co
SUPABASE_ANON_KEY=cambiame
SUPABASE_SERVICE_ROLE_KEY=cambiame
