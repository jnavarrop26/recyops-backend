  token: {{token}}
}

params:path {
  id: uuid-de-la-linea
}

body:json {
  {
    "cantidad": 12.5,
    "motivo": "Material contaminado con humedad"
  }
}

docs {
  Descuenta una perdida de material del stock.
}
