meta {
  name: Cambiar Estado Proveedor
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/proveedores/:id/estado?valor=ACTIVO
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  id: uuid-del-proveedor
}

params:query {
  valor: ACTIVO
}

docs {
  valor: ACTIVO | INACTIVO | BLOQUEADO
}
