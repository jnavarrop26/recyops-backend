    "bodegaId": "uuid-de-la-bodega",
    "prioridad": "ALTA",
    "fechaLimite": "2026-07-20"
  }
}

docs {
  Solo rol ADMIN.
  prioridad: BAJA | MEDIA | ALTA
}
