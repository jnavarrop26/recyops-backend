<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sistema de logs de RecyOps:
    logs/recyops-api.log   -> log general de la aplicacion (INFO+)
    logs/transacciones.log -> operaciones de negocio (logger TRANSACCIONES)
    logs/errores.log       -> solo WARN y ERROR, con stack trace completo
  Cada archivo rota al llegar a 20 MB y se conservan 30 dias de historico.
  Cada linea incluye el usuario autenticado y el esquema de empresa (MDC).
-->
<configuration>

    <property name="RUTA_LOGS" value="logs"/>
    <property name="PATRON"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [usuario=%X{usuario:-anonimo}|empresa=%X{empresa:-}] %logger{40} - %msg%n"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATRON}</pattern>
        </encoder>
    </appender>

    <appender name="ARCHIVO_GENERAL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${RUTA_LOGS}/recyops-api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${RUTA_LOGS}/recyops-api.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
        </encoder>
    </appender>

    <appender name="ARCHIVO_TRANSACCIONES" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${RUTA_LOGS}/transacciones.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${RUTA_LOGS}/transacciones.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
        </encoder>
    </appender>

    <appender name="ARCHIVO_ERRORES" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${RUTA_LOGS}/errores.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${RUTA_LOGS}/errores.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
        </encoder>
    </appender>

    <!-- Log transaccional: solo lo que emite el AspectoLogTransaccional -->
    <logger name="TRANSACCIONES" level="DEBUG" additivity="false">
        <appender-ref ref="ARCHIVO_TRANSACCIONES"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO_GENERAL"/>
        <appender-ref ref="ARCHIVO_ERRORES"/>
    </root>

</configuration>
